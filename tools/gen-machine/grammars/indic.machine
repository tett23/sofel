# The syllable machine of HarfBuzz 15.1.0's src/hb-ot-shaper-indic-machine.rl
# (MIT; see THIRD_PARTY_NOTICES.md): its categories and rules, with each
# action replaced by the number of its syllable type:
#   0 indic_consonant_syllable
#   1 indic_vowel_syllable
#   2 indic_standalone_cluster
#   3 indic_symbol_cluster
#   4 indic_broken_cluster
#   5 indic_non_indic_cluster
# Read by tools/gen-machine (ADR 0024).

export X    = 0;
export C    = 1;
export V    = 2;
export N    = 3;
export H    = 4;
export ZWNJ = 5;
export ZWJ  = 6;
export M    = 7;
export SM   = 8;
export A    = 9;
export VD   = 9;
export PLACEHOLDER = 10;
export DOTTEDCIRCLE = 11;
export RS    = 12;
export MPst  = 13;
export Repha = 14;
export Ra    = 15;
export CM    = 16;
export Symbol= 17;
export CS    = 18;
export SMPst = 57;

c = (C | Ra);			# is_consonant
n = ((ZWNJ?.RS)? (N.N?)?);	# is_consonant_modifier
z = ZWJ|ZWNJ;			# is_joiner
reph = (Ra H | Repha);		# possible reph
sm = SM | SMPst;

cn = c.ZWJ?.n?;
symbol = Symbol.N?;
matra_group = z*.(M | sm? MPst).N?.H?;
syllable_tail = (z?.sm.sm?.ZWNJ?)? (A | VD)*;
halant_group = (z?.H.(ZWJ.N?)?);
final_halant_group = halant_group | H.ZWNJ;
medial_group = CM?;
halant_or_matra_group = (final_halant_group | matra_group*);

complex_syllable_tail = (halant_group.cn)* medial_group halant_or_matra_group syllable_tail;

consonant_syllable =	(Repha|CS)? cn complex_syllable_tail;
vowel_syllable =	reph? V.n? (ZWJ | complex_syllable_tail);
standalone_cluster =	((Repha|CS)? PLACEHOLDER | reph? DOTTEDCIRCLE).n? complex_syllable_tail;
symbol_cluster =	symbol syllable_tail;
broken_cluster =	reph? n? complex_syllable_tail;
other =			any;

main := |*
	consonant_syllable	=> 0;	# indic_consonant_syllable
	vowel_syllable		=> 1;	# indic_vowel_syllable
	standalone_cluster	=> 2;	# indic_standalone_cluster
	symbol_cluster		=> 3;	# indic_symbol_cluster
	SMPst			=> 5;	# indic_non_indic_cluster
	broken_cluster		=> 4;	# indic_broken_cluster
	other			=> 5;	# indic_non_indic_cluster
*|;

